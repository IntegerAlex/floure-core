pkgname=floure
pkgver=0.3.0
pkgrel=1
pkgdesc='Local-first dictation with a native GPUI interface'
arch=('x86_64')
url='https://github.com/IntegerAlex/floure-core'
license=('GPL-3.0-or-later')
options=('!debug')
depends=(
  'alsa-lib'
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'libx11'
  'libxkbcommon'
  'openssl'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('clang' 'cmake' 'git' 'pkgconf' 'rust')
optdepends=(
  'wl-clipboard: clipboard support on Wayland'
  'wtype: type text on Wayland'
  'xclip: clipboard support on X11'
  'xdotool: type text and paste on X11'
  'ydotool: type text on GNOME Wayland'
)
_source_version=${pkgver//_/-}
source=("$pkgname-$pkgver.tar.gz::https://github.com/IntegerAlex/floure-core/archive/refs/tags/v${_source_version}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/floure-core-$_source_version"
  cargo build --release --locked -p floure-app
}

package() {
  cd "$srcdir/floure-core-$_source_version"
  install -Dm755 target/release/floure "$pkgdir/usr/bin/floure"
  install -Dm644 packaging/floure.desktop "$pkgdir/usr/share/applications/floure.desktop"
  install -Dm644 packaging/floure.metainfo.xml "$pkgdir/usr/share/metainfo/floure.metainfo.xml"
  for size in 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/floure.png"
  done
  install -Dm644 packaging/icons/floure.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/floure.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/floure/LICENSE"
  install -Dm644 crates/floure-app/assets/fonts/OFL.txt \
    "$pkgdir/usr/share/licenses/floure/OFL-Inter.txt"
}
